# 复制为 .env 后再填写，或者直接在终端里 export 这些变量。
# .env 已被 .gitignore 忽略，不会被提交。
#
# 应用本身不需要任何环境变量 —— 供应商配置在网页设置面板里填写。
# 这些变量只供需要真实 API 的测试脚本使用（test-animated.js / verify.js）。

# OpenAI 兼容供应商地址，填到 /v1
API_BASE_URL=https://api.openai.com/v1

# 你的 API Key（请勿提交真实值）
API_KEY=sk-your-key-here

# 图片模型名
API_MODEL=gpt-image-1

# 鉴权方式：bearer / x-api-key / both / none
API_AUTH_STYLE=bearer

# 可选：图生图测试用的本地图片路径
# IMG_PATH=./samples/input.png

# 可选：指定 Chromium 路径（测试脚本会自动查找，通常不需要设置）
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
